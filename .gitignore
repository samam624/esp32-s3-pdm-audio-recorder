# Local Claude Code settings/runtime state (machine-specific)
.claude/
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Python runtime artifacts
__pycache__/
*.py[cod]

# OS cruft
Thumbs.db
.DS_Store

# MMSA V2 captures can grow quickly. Keep generated recordings local except
# for the small, known sample used by the visualization examples.
MMSA V2/data/**/*.wav
!MMSA V2/data/MMSA8_0084.wav
